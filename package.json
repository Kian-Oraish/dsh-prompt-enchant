{
  "name": "dsh-prompt-enhance",
  "version": "0.7.0",
  "description": "提示词附魔棒 (dsh-prompt-enchant):DSH Web 对话输入框的灵活自适应提示词增强插件(磁盘常驻版,重启自动加载;支持人设模式切换)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:no-sentinel": "PE_SKIP_SENTINEL=1 node --test tests/*.test.mjs",
    "sentinel": "node tests/contract-sentinel.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6-alpha.0 <0.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.0 <0.2.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.6-alpha.0 <0.2.0",
    "@deepseek-ai/dsh-util-crypto": ">=0.1.6-alpha.0 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "prompt-enhancement",
    "cordis-plugin",
    "ai"
  ],
  "license": "MIT",
  "author": "Kian-Oraish",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kian-Oraish/dsh-prompt-enchant.git"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/modes.js",
    "lib/ref-guard.js",
    "lib/suggest.js",
    "lib/confirm.js",
    "cordis.patch.yml",
    "config/",
    "assets/icons/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.sh",
    "screenshots.json"
  ]
}
