{
  "name": "dsh-prompt-enhance",
  "version": "0.3.3",
  "description": "提示词附魔棒 (dsh-prompt-enchant):DSH Web 对话输入框的灵活自适应提示词增强插件(磁盘常驻版,重启自动加载;支持人设模式切换)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "prompt-enhancement",
    "cordis-plugin",
    "ai"
  ],
  "license": "MIT",
  "author": "Kian-Oraish",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kian-Oraish/dsh-prompt-enchant.git"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/ref-guard.js",
    "lib/modes.js",
    "cordis.patch.yml",
    "config/",
    "assets/icons/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "install.sh",
    "screenshots.json"
  ]
}
